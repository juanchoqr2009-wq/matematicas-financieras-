<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Matemática Financiera 8.2</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#f6f7f9;--card:#fff;--tx:#1b2430;--mu:#5d6b7c;--ac:#0f6b5c;--bd:#d9dee5;--ok:#0f7b3f;--bad:#b3261e;--hd:#e8f1ef}
:root:not([data-theme="light"]){}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#12171d;--card:#1b222b;--tx:#e6ebf1;--mu:#96a3b3;--ac:#4fc3ab;--bd:#2d3844;--ok:#5fd08a;--bad:#ff8a80;--hd:#22303a}}
:root[data-theme="dark"]{--bg:#12171d;--card:#1b222b;--tx:#e6ebf1;--mu:#96a3b3;--ac:#4fc3ab;--bd:#2d3844;--ok:#5fd08a;--bad:#ff8a80;--hd:#22303a}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--tx);font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
header{padding:20px 16px 8px;max-width:980px;margin:auto}
h1{font-size:22px;margin:0}header p{margin:4px 0 0;color:var(--mu)}
nav{display:flex;gap:6px;overflow-x:auto;padding:10px 16px;max-width:980px;margin:auto}
nav button{flex:none;border:1px solid var(--bd);background:var(--card);color:var(--tx);padding:8px 14px;border-radius:20px;font:inherit;cursor:pointer}
nav button.on{background:var(--ac);color:#fff;border-color:var(--ac)}
main{max-width:980px;margin:auto;padding:0 16px 40px}
section{display:none;background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:16px}
section.on{display:block}
h2{font-size:17px;margin:0 0 4px}.sub{color:var(--mu);margin:0 0 12px;font-size:13px}
.g{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:12px}
label{display:flex;flex-direction:column;font-size:12px;color:var(--mu);gap:3px}
input,select,textarea{font:inherit;color:var(--tx);background:var(--bg);border:1px solid var(--bd);border-radius:8px;padding:8px;width:100%}
.res{background:var(--hd);border-radius:10px;padding:12px;margin-top:8px}
.kpi{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px}
.kpi div{background:var(--card);border:1px solid var(--bd);border-radius:8px;padding:8px}
.kpi b{display:block;font-size:17px}.kpi span{font-size:12px;color:var(--mu)}
.tw{overflow-x:auto;margin-top:8px}table{border-collapse:collapse;width:100%;font-size:13px}
th,td{padding:6px 8px;border-bottom:1px solid var(--bd);text-align:right;white-space:nowrap}th{background:var(--hd)}th:first-child,td:first-child{text-align:left}
.ok{color:var(--ok)}.bad{color:var(--bad)}li{margin:4px 0}
svg text{fill:var(--tx);font-size:11px}
</style></head><body>
<header><h1>Herramientas de Matemática Financiera</h1><p>Guía 8.2: cálculos y procesos financieros</p></header>
<nav id="nav"></nav>
<main>
<section id="s0"><h2>Conversión de tasas</h2><p class="sub">Nominales a efectivas, anuales a periódicas, vencidas y anticipadas.</p>
<div class="g">
<label>Tipo de tasa dada<select id="t1t"><option value="nv">Nominal vencida</option><option value="na">Nominal anticipada</option><option value="ea">Efectiva anual</option><option value="pv">Periódica vencida</option><option value="pa">Periódica anticipada</option></select></label>
<label>Tasa (%)<input id="t1r" type="number" step="any" value="24"></label>
<label>Periodicidad de la tasa dada<select id="t1m"><option value="12">Mensual (12)</option><option value="6">Bimestral (6)</option><option value="4">Trimestral (4)</option><option value="2">Semestral (2)</option><option value="1">Anual (1)</option></select></label>
<label>Convertir a periodicidad<select id="t2m"><option value="1">Anual</option><option value="2">Semestral</option><option value="4" selected>Trimestral</option><option value="6">Bimestral</option><option value="12">Mensual</option></select></label></div>
<div id="o0"></div></section>

<section id="s1"><h2>Valor del dinero en el tiempo</h2><p class="sub">Valor presente, valor futuro y anualidades. La tasa debe ser efectiva por periodo.</p>
<div class="g">
<label>Calcular<select id="v0"><option value="vf">VF (pago único)</option><option value="vp">VP (pago único)</option><option value="vpa">VP de anualidad</option><option value="vfa">VF de anualidad</option><option value="apv">Cuota A dado VP</option><option value="afv">Cuota A dado VF</option></select></label>
<label>VP<input id="v1" type="number" step="any" value="1000000"></label>
<label>VF<input id="v2" type="number" step="any" value="2000000"></label>
<label>Cuota A<input id="v3" type="number" step="any" value="100000"></label>
<label>Tasa por periodo (%)<input id="v4" type="number" step="any" value="2"></label>
<label>Periodos n<input id="v5" type="number" step="any" value="12"></label>
<label>Tipo de anualidad<select id="v6"><option value="0">Vencida</option><option value="1">Anticipada</option></select></label></div>
<div id="o1"></div></section>

<section id="s2"><h2>Diagramas económicos</h2><p class="sub">Flujos por periodo separados por coma (periodo 0 primero). Positivo = ingreso, negativo = egreso.</p>
<label>Flujos<textarea id="d1" rows="2">-1000, 300, 400, 500, 600</textarea></label><div id="o2" class="tw"></div></section>

<section id="s3"><h2>Tablas de amortización</h2><p class="sub">Cuota constante (francés) y cuota decreciente (abono constante a capital).</p>
<div class="g">
<label>Sistema<select id="a0"><option value="c">Cuota constante</option><option value="d">Cuota decreciente</option></select></label>
<label>Préstamo<input id="a1" type="number" step="any" value="10000000"></label>
<label>Tasa por periodo (%)<input id="a2" type="number" step="any" value="1.5"></label>
<label>Periodos n<input id="a3" type="number" step="1" value="12"></label></div>
<div id="o3"></div></section>

</main>
<script>
const $=id=>document.getElementById(id),N=id=>parseFloat($(id).value);
const f=(x,d=2)=>isFinite(x)?x.toLocaleString('es-CO',{minimumFractionDigits:d,maximumFractionDigits:d}):'—';
const pc=x=>isFinite(x)?(x*100).toLocaleString('es-CO',{minimumFractionDigits:4,maximumFractionDigits:4})+' %':'—';
const K=(l,v)=>`<div><span>${l}</span><b>${v}</b></div>`;
const tabs=['Tasas','Valor del dinero','Diagramas','Amortización'];
tabs.forEach((t,i)=>{const b=document.createElement('button');b.textContent=t;b.onclick=()=>show(i);$('nav').appendChild(b)});
function show(i){document.querySelectorAll('section').forEach((s,j)=>s.classList.toggle('on',i==j));[...$('nav').children].forEach((b,j)=>b.classList.toggle('on',i==j))}
const flows=s=>s.split(/[,;\s]+/).filter(Boolean).map(Number).filter(isFinite);

function tasas(){
 const r=N('t1r')/100,m=+$('t1m').value,tp=$('t1t').value;let EA;
 if(tp=='nv')EA=(1+r/m)**m-1;else if(tp=='na')EA=(1/(1-r/m))**m-1;else if(tp=='ea')EA=r;
 else if(tp=='pv')EA=(1+r)**m-1;else EA=(1/(1-r))**m-1;
 const row=(nm,k)=>{const ip=(1+EA)**(1/k)-1,ia=ip/(1+ip);return `<tr><td>${nm}</td><td>${pc(ip)}</td><td>${pc(ia)}</td><td>${pc(ip*k)}</td><td>${pc(ia*k)}</td></tr>`};
 const k=+$('t2m').value,ip=(1+EA)**(1/k)-1,ia=ip/(1+ip);
 $('o0').innerHTML=`<div class="res"><div class="kpi">${K('Efectiva anual',pc(EA))}${K('Periódica vencida',pc(ip))}${K('Periódica anticipada',pc(ia))}${K('Nominal vencida',pc(ip*k))}${K('Nominal anticipada',pc(ia*k))}</div></div>
 <div class="tw"><table><tr><th>Periodicidad</th><th>Periódica vencida</th><th>Periódica anticip.</th><th>Nominal vencida</th><th>Nominal anticip.</th></tr>${[['Mensual',12],['Bimestral',6],['Trimestral',4],['Semestral',2],['Anual',1]].map(a=>row(a[0],a[1])).join('')}</table></div>`}

function vdt(){
 const c=$('v0').value,VP=N('v1'),VF=N('v2'),A=N('v3'),i=N('v4')/100,n=N('v5'),a=+$('v6').value,u=(1+i)**n;
 const fa=i?(u-1)/i:n,pa=i?(1-1/u)/i:n,adj=a?1+i:1;let r,l;
 if(c=='vf'){r=VP*u;l='Valor futuro = VP·(1+i)ⁿ'}
 else if(c=='vp'){r=VF/u;l='Valor presente = VF/(1+i)ⁿ'}
 else if(c=='vpa'){r=A*pa*adj;l='VP de la anualidad'}
 else if(c=='vfa'){r=A*fa*adj;l='VF de la anualidad'}
 else if(c=='apv'){r=VP/(pa*adj);l='Cuota A'}
 else{r=VF/(fa*adj);l='Cuota A'}
 $('o1').innerHTML=`<div class="res"><div class="kpi">${K(l,f(r))}${K('Factor (1+i)ⁿ',f(u,6))}</div></div>`}

function draw(fl,W0){
 const st=64,W=Math.max(W0||600,fl.length*st+50),y=130,mx=Math.max(...fl.map(Math.abs))||1;
 let s=`<svg viewBox="0 0 ${W} 270" width="${W}" height="270"><line x1="20" y1="${y}" x2="${W-15}" y2="${y}" stroke="currentColor" stroke-width="1.5"/>`;
 fl.forEach((v,i)=>{const x=40+i*st,h=Math.abs(v)/mx*95+8,up=v>=0,ty=up?y-h:y+h,c=up?'#0f7b3f':'#b3261e';
  s+=`<line x1="${x}" y1="${y}" x2="${x}" y2="${ty}" stroke="${c}" stroke-width="2"/><polygon fill="${c}" points="${x},${ty} ${x-4},${ty+(up?8:-8)} ${x+4},${ty+(up?8:-8)}"/>`;
  s+=`<text x="${x}" y="${up?ty-6:ty+14}" text-anchor="middle">${f(v,0)}</text><text x="${x}" y="262" text-anchor="middle" opacity=".7">${i}</text>`});
 return s+'</svg>'}
function diag(){$('o2').innerHTML=draw(flows($('d1').value))}

function amort(){
 const P=N('a1'),i=N('a2')/100,n=Math.round(N('a3')),d=$('a0').value=='d';
 if(!(n>0))return;let s=P,rows='',TC=0,TI=0;
 const A=i?P*i/(1-(1+i)**-n):P/n;
 for(let k=1;k<=n;k++){const it=s*i,ab=d?P/n:A-it,q=ab+it;s-=ab;TC+=q;TI+=it;
  rows+=`<tr><td>${k}</td><td>${f(q)}</td><td>${f(it)}</td><td>${f(ab)}</td><td>${f(Math.abs(s)<1e-6?0:s)}</td></tr>`}
 $('o3').innerHTML=`<div class="res"><div class="kpi">${K('Primera cuota',f(d?P/n+P*i:A))}${K('Total intereses',f(TI))}${K('Total pagado',f(TC))}</div></div>
 <div class="tw"><table><tr><th>Periodo</th><th>Cuota</th><th>Interés</th><th>Abono a capital</th><th>Saldo</th></tr>${rows}</table></div>`}

function all(){[tasas,vdt,diag,amort].forEach(fn=>{try{fn()}catch(e){}})}
document.addEventListener('input',all);all();show(0);
</script></body></html>
